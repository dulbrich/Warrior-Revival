# Supabase — populate these in .env.local (local dev) and Vercel env settings (prod).
# URL and anon key are also exposed to the browser bundle (Supabase Auth client +
# read-only queries). The service-role key is server-only and bypasses RLS; never
# expose it to client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed to access /admin. The auth middleware
# verifies the logged-in user's email matches one of these; magic-link signups
# from other emails will succeed at Supabase Auth but be bounced from /admin.
ADMIN_EMAILS=
