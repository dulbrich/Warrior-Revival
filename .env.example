# Supabase — populate these in .env.local (local dev) and Vercel env settings (prod).
# URL and anon key are also exposed to the browser bundle (Supabase Auth client +
# read-only queries). The service-role key is server-only and bypasses RLS; never
# expose it to client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 — optional override for the site's default Measurement ID.
# Set to an empty value to disable analytics. Admin pages are never tracked.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Note: admin/contributor role lives in auth.users.app_metadata.role and is
# managed via /admin/users. To bootstrap the first admin run:
#   npm run promote:admin -- <email>
# Then the promoted user must sign out and back in to refresh their JWT.

# Dev-only: when set AND NODE_ENV=development, the /admin/dev-signin route
# generates a real session for this email via the Supabase admin API so you
# don't have to click a magic link on every dev restart. Hard-gated to dev
# in middleware.ts and the route itself; never honored in production builds.
DEV_AUTH_EMAIL=
