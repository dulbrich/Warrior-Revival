# Supabase — populate these in .env.local (local dev) and Vercel env settings (prod).
# URL and anon key are also exposed to the browser bundle (Supabase Auth client +
# read-only queries). The service-role key is server-only and bypasses RLS; never
# expose it to client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Note: admin/contributor role lives in auth.users.app_metadata.role and is
# managed via /admin/users. To bootstrap the first admin run:
#   npm run promote:admin -- <email>
# Then the promoted user must sign out and back in to refresh their JWT.
